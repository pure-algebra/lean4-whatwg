import WhatwgGates.Ledger.Model

/-!
# Gates.Ledger.Render

The markdown projection of one graph's ledger entry
(`test/contracts/graph-ledger.contract.md`, section 8): a header naming the
generator, the regeneration command and the canonical input, the graph's
document, receipts log, fence and dependencies, then the ten-edge table of
ruling R-V4 with one row per edge in `Edge.all` order. Imports only the
model.

The index of the whole ledger, `generated/graphs/INDEX.md` (addendum D.6 of
the contract, ruling R-W22), is rendered here too, from the ledger alone: the
totals, one row per graph with its open, closed and not-applicable edge
counts, one row per leaf record and one row per unrouted prefix. It reads
neither the environment nor a file, and it lists no fence and no routed
module.

The text is byte-deterministic: LF line ends, one final LF, no timestamp, no
commit and no absolute path, so `lake exe whatwg_ledger` can compare each
file under `generated/graphs/` with a fresh rendering byte for byte.
`formatVersion` is bumped whenever the rendered shape changes.
-/

namespace Gates.Ledger

/-- Projection format version, bumped when the rendered shape changes. -/
def formatVersion : Nat := 1

/-- A text in backticks. -/
def code (s : String) : String := "`" ++ s ++ "`"

/-- An English list: `a`, `a and b`, `a, b and c`. -/
def joinAnd : List String → String
  | [] => ""
  | [a] => a
  | [a, b] => a ++ " and " ++ b
  | a :: rest => a ++ ", " ++ joinAnd rest

/-- A list of names, each in backticks, joined by `joinAnd`. -/
private def namesText (ns : List Lean.Name) : String :=
  joinAnd (ns.map fun n => code (toString n))

/-- A row range with its status: one identifier, or the first and the last. -/
private def rowsText (r : RowRange) (s : RowStatus) : String :=
  if r.first == r.last then code (r.ids.headD r.family) ++ " " ++ code s.text
  else code (r.ids.headD r.family) ++ " to " ++ code (r.ids.getLastD r.family) ++ " " ++ code s.text

/-- One ground as the projection spells it. -/
def Ground.render : Ground → String
  | .theorems ns => "theorems " ++ namesText ns
  | .declarations ns => "declarations " ++ namesText ns
  | .receipts m n => toString n ++ " receipts of " ++ code (toString m)
  | .ascriptions m n => toString n ++ " ascriptions of " ++ code (toString m)
  | .modules ms => "modules " ++ namesText ms
  | .gate g => code g.command
  | .ruling r => "ruling " ++ r
  | .receipt h => "receipt \"" ++ h ++ "\""
  | .rows r s => rowsText r s
  | .edge g e => code g ++ " " ++ e.label ++ " closed"

/-- One open item as the projection spells it. -/
def Item.render : Item → String
  | .named l => l
  | .debt d => "debt " ++ d
  | .rows r s => rowsText r s
  | .wanted n => "wanted " ++ code (toString n)
  | .edge g e => code g ++ " " ++ e.label ++ " (open)"

/-- The ground column of one edge row, its parts joined by one space and the
empty ones omitted: the note; `Open: ` and the items; the grounds, prefixed
`Closed on: ` for a closed cell, `Discharged: ` for an open one and
`Recorded by: ` for a not-applicable one; then `Debts recorded: ` and the
debts. -/
def Cell.render (c : Cell) : String :=
  let groundsLead := match c.status with
    | .requiredClosed => "Closed on: "
    | .requiredOpen => "Discharged: "
    | .notApplicable => "Recorded by: "
  let parts : List String :=
    (if c.note.isEmpty then [] else [c.note]) ++
    (if c.remaining.isEmpty then [] else
      ["Open: " ++ String.intercalate "; " (c.remaining.map Item.render) ++ "."]) ++
    (if c.grounds.isEmpty then [] else
      [groundsLead ++ String.intercalate "; " (c.grounds.map Ground.render) ++ "."]) ++
    (if c.debts.isEmpty then [] else
      ["Debts recorded: " ++ joinAnd c.debts ++ "."])
  String.intercalate " " parts

/-- The projection of one graph, `generated/graphs/<GRAPH-ID>.md`, ending in
one LF. `input` names the canonical input in the header. -/
def Graph.render (g : Graph) (input : String) : String :=
  let header := [
    "<!-- GENERATED by `lake exe whatwg_ledger --write` (Gates.Ledger, format " ++
      toString formatVersion ++ ") from " ++ input ++ "; do not edit. -->",
    "",
    "# Current state of " ++ code g.id,
    "",
    "Graph document: " ++ code g.document ++ ". Receipts log: " ++ code g.receiptsLog ++ ".",
    "Fence: " ++ (if g.fence.isEmpty then "none" else namesText g.fence) ++ ".",
    "Depends on: " ++
      (if g.dependsOn.isEmpty then "none" else joinAnd (g.dependsOn.map code)) ++ ".",
    "",
    "| Edge | Status | Ground |",
    "| --- | --- | --- |"]
  let rows := Edge.all.map fun e =>
    let c := g.edges.get e
    "| " ++ e.label ++ " | " ++ code c.status.text ++ " | " ++ c.render ++ " |"
  String.intercalate "\n" (header ++ rows) ++ "\n"

/-! ## The index (addendum D.6) -/

/-- The index projection's path, relative to the repository root. -/
def indexPath : String := "generated/graphs/INDEX.md"

/-- The number of the graph's ten edges whose cell has status `s`. -/
def Graph.countStatus (g : Graph) (s : Status) : Nat :=
  (Edge.all.filter fun e => (g.edges.get e).status == s).length

/-- The parent column of a leaf row: `standalone`, or the parent graph's
identifier in backticks, a space and the edge label. -/
private def parentText : Option (String × Edge) → String
  | none => "standalone"
  | some (g, e) => code g ++ " " ++ e.label

/-- A section's rows: the table under its two header lines, or the single line
`None.` when there is no row. -/
private def tableOrNone (header : List String) (rows : List String) : List String :=
  if rows.isEmpty then ["None."] else header ++ rows

/-- The index projection, `generated/graphs/INDEX.md`, ending in one LF: the
graph projections' header with `input` as the canonical input, the totals, one
row per graph with its open, closed and not-applicable edge counts and a
relative link to its projection, one row per leaf record with its parent and
its number of declarations, and one row per unrouted prefix with the debt or
ruling that records it, each in ledger order. A function of the ledger
alone. -/
def Ledger.renderIndex (l : Ledger) (input : String) : String :=
  let total (s : Status) : Nat := (l.graphs.map (·.countStatus s)).foldl (· + ·) 0
  let header := [
    "<!-- GENERATED by `lake exe whatwg_ledger --write` (Gates.Ledger, format " ++
      toString formatVersion ++ ") from " ++ input ++ "; do not edit. -->",
    "",
    "# Graph ledger index",
    "",
    "Totals: " ++ toString l.graphs.length ++ " graph(s), " ++ toString (10 * l.graphs.length) ++
      " edges (" ++ toString (total .requiredOpen) ++ " " ++ Status.requiredOpen.text ++ ", " ++
      toString (total .requiredClosed) ++ " " ++ Status.requiredClosed.text ++ ", " ++
      toString (total .notApplicable) ++ " " ++ Status.notApplicable.text ++ "), " ++
      toString l.leaves.length ++ " leaf record(s), " ++ toString l.unrouted.length ++
      " unrouted prefix(es).",
    "",
    "## Graphs",
    ""]
  let graphs := tableOrNone
    ["| Graph | Document | Open | Closed | Not applicable |", "| --- | --- | ---: | ---: | ---: |"]
    (l.graphs.map fun g =>
      "| [" ++ code g.id ++ "](" ++ g.id ++ ".md) | " ++ code g.document ++ " | " ++
        toString (g.countStatus .requiredOpen) ++ " | " ++
        toString (g.countStatus .requiredClosed) ++ " | " ++
        toString (g.countStatus .notApplicable) ++ " |")
  let leaves := tableOrNone
    ["| Leaf | Document | Parent | Declarations |", "| --- | --- | --- | ---: |"]
    (l.leaves.map fun leaf =>
      "| " ++ code leaf.id ++ " | " ++ code leaf.document ++ " | " ++ parentText leaf.parent ++
        " | " ++ toString leaf.declarations.length ++ " |")
  let unrouted := tableOrNone
    ["| Prefix | Recorded by |", "| --- | --- |"]
    (l.unrouted.map fun u => "| " ++ code (toString u.modulePrefix) ++ " | " ++ u.recordedBy ++ " |")
  String.intercalate "\n"
    (header ++ graphs ++ ["", "## Leaf records", ""] ++ leaves ++
      ["", "## Unrouted prefixes", ""] ++ unrouted) ++ "\n"

end Gates.Ledger
