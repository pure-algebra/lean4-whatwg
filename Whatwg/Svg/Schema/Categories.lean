namespace Whatwg.Svg.Schema

/-- An element category of SVG 2. -/
inductive Category where
  | container | descriptive | gradient | graphics | graphics_referencing | paint_server | shape | structural
  | structurally_external | text_content | text_content_child | never_rendered | renderable | filter_primitive | light_source | transfer_function
  | animation
  deriving DecidableEq, Repr, Inhabited, Hashable

/-- Every element category, in the order of the definitions files. -/
def Category.all : List Category :=
  [.container, .descriptive, .gradient, .graphics, .graphics_referencing, .paint_server, .shape, .structural,
   .structurally_external, .text_content, .text_content_child, .never_rendered, .renderable, .filter_primitive, .light_source, .transfer_function,
   .animation]

/-- The category's name, as the definitions spell it. -/
def Category.name : Category → String
  | .container => "container"
  | .descriptive => "descriptive"
  | .gradient => "gradient"
  | .graphics => "graphics"
  | .graphics_referencing => "graphics referencing"
  | .paint_server => "paint server"
  | .shape => "shape"
  | .structural => "structural"
  | .structurally_external => "structurally external"
  | .text_content => "text content"
  | .text_content_child => "text content child"
  | .never_rendered => "never-rendered"
  | .renderable => "renderable"
  | .filter_primitive => "filter primitive"
  | .light_source => "light source"
  | .transfer_function => "transfer function"
  | .animation => "animation"

/-- The elements of the category, in the definitions' order. -/
def Category.members : Category → List Tag
  | .container =>
    [.svg, .g, .defs, .symbol, .clipPath, .mask, .pattern, .marker, .a, .switch]
  | .descriptive =>
    [.desc, .title, .metadata]
  | .gradient =>
    [.linearGradient, .radialGradient]
  | .graphics =>
    [.path, .text, .tspan, .textPath, .rect, .circle, .ellipse, .line, .polyline, .polygon, .image,
     .foreignObject]
  | .graphics_referencing =>
    [.use, .image]
  | .paint_server =>
    [.linearGradient, .radialGradient, .pattern]
  | .shape =>
    [.circle, .ellipse, .line, .path, .polygon, .polyline, .rect]
  | .structural =>
    [.defs, .g, .svg, .symbol, .use]
  | .structurally_external =>
    [.script, .image, .use, .foreignObject]
  | .text_content =>
    [.text, .tspan, .textPath]
  | .text_content_child =>
    [.tspan, .textPath]
  | .never_rendered =>
    [.defs, .desc, .title, .metadata, .clipPath, .mask, .marker, .pattern, .linearGradient,
     .radialGradient, .script, .style]
  | .renderable =>
    [.svg, .g, .a, .switch, .path, .text, .rect, .circle, .ellipse, .line, .polyline, .polygon,
     .image, .use, .foreignObject, .tspan, .textPath]
  | .filter_primitive =>
    [.feBlend, .feFlood, .feColorMatrix, .feComponentTransfer, .feComposite, .feConvolveMatrix,
     .feDiffuseLighting, .feDisplacementMap, .feDropShadow, .feGaussianBlur, .feImage, .feMerge,
     .feMorphology, .feOffset, .feSpecularLighting, .feTile, .feTurbulence]
  | .light_source =>
    [.feDistantLight, .fePointLight, .feSpotLight]
  | .transfer_function =>
    [.feFuncR, .feFuncG, .feFuncB, .feFuncA]
  | .animation =>
    [.animate, .animateMotion, .animateTransform, .set]

end Whatwg.Svg.Schema
