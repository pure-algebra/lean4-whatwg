  | .presentation =>
    [.alignment_baseline, .baseline_shift, .clip, .clip_path, .clip_rule, .color,
     .color_interpolation, .color_interpolation_filters, .cursor, .direction, .display,
     .dominant_baseline, .fill, .fill_opacity, .fill_rule, .filter, .flood_color, .flood_opacity,
