/-- An attribute category of SVG 2. -/
inductive AttrCategory where
  | aria | conditional_processing | core | presentation | document_event | window_event | global_event | deprecated_xlink
  | filter_primitive | transfer_function_element | animation_event | animation_target_element | animation_attribute_target | animation_timing | animation_value | animation_addition
  deriving DecidableEq, Repr, Inhabited, Hashable

/-- Every attribute category, in the order first declared. -/
def AttrCategory.all : List AttrCategory :=
  [.aria, .conditional_processing, .core, .presentation, .document_event, .window_event, .global_event, .deprecated_xlink,
   .filter_primitive, .transfer_function_element, .animation_event, .animation_target_element, .animation_attribute_target, .animation_timing, .animation_value, .animation_addition]

/-- The category's name, as the definitions spell it. -/
def AttrCategory.name : AttrCategory → String
  | .aria => "aria"
  | .conditional_processing => "conditional processing"
  | .core => "core"
  | .presentation => "presentation"
  | .document_event => "document event"
  | .window_event => "window event"
  | .global_event => "global event"
  | .deprecated_xlink => "deprecated xlink"
  | .filter_primitive => "filter primitive"
  | .transfer_function_element => "transfer function element"
  | .animation_event => "animation event"
  | .animation_target_element => "animation target element"
  | .animation_attribute_target => "animation attribute target"
  | .animation_timing => "animation timing"
  | .animation_value => "animation value"
  | .animation_addition => "animation addition"

/-- The attributes of the category: those its entries nest, then its presentation attributes.
Two entries that declare one category are merged. -/
