     .vector_effect, .visibility, .word_spacing, .writing_mode]
  | .document_event =>
    [.onunload, .onabort, .onerror, .onresize, .onscroll]
  | .window_event =>
    [.onafterprint, .onbeforeprint, .onhashchange, .onmessage, .onoffline, .ononline, .onpagehide,
     .onpageshow, .onpopstate, .onstorage, .onunload]
  | .global_event =>
