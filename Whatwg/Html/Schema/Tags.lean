/-- The void elements, from the standard's own list (`Void elements` in the
syntax section, span digest `ea1587f765d47b71693a9ff5a9c60833ee93d21396af36007f9d317c64015101`). -/
def Tag.isVoid : Tag → Bool
  | .base | .link | .«meta» | .hr | .br | .wbr | .source | .img
  | .embed | .track | .area | .col | .input => true
  | _ => false

/-- The transparent elements: their content is their context's, minus what they exclude (`Whatwg.Html.Schema.Readings.transparents`). -/
def Tag.isTransparent : Tag → Bool
  | .a | .ins | .del | .object | .video | .audio | .map | .noscript
  | .slot | .canvas => true
  | _ => false

