/-- The element of a tag. -/
def Tag.element? (t : Tag) : Option Element :=
  t.elementIndex?.bind (elements[·]?)

/-- The direct children a sentence admits first and outside any content set
(`source` and `track` under `audio` and `video`, `area` under `map`). -/
def labelledChild : Tag → Tag → Bool
  | .audio, .source => true
  | .audio, .track => true
  | .video, .source => true
  | .video, .track => true
  | .map, .area => true
  | _, _ => false

