  | .datalist => .phrasing_with_option
  | .optgroup => .only_legend_option_noscript_div
  | .option => .text
  | .textarea => .text
  | .output => .phrasing
  | .progress => .phrasing
  | .meter => .phrasing
  | .fieldset => .flow_with_legend
  | .legend => .phrasing_with_heading
  | .selectedcontent => .nothing
  | .details => .flow_with_summary
  | .summary => .phrasing_with_heading
  | .dialog => .flow
  | .script => .text
  | .noscript => .flow
  | .template => .flow
  | .slot => .flow
  | .canvas => .flow
  | .pcdata => .nothing

/-- The descendant exclusions an element adds to its context. -/
def Tag.ownExcl : Tag → Exclusions
  | .header => { footer := true, header := true }
  | .footer => { footer := true, header := true }
  | .address => { heading := true, sectioning := true, address := true, footer := true, header := true }
  | .dt => { heading := true, sectioning := true, footer := true, header := true }
  | .a => { interactive := true, a := true }
  | .dfn => { dfn := true }
  | .video => { media := true }
  | .audio => { media := true }
  | .caption => { table := true }
  | .th => { heading := true, sectioning := true, footer := true, header := true }
  | .form => { form := true }
  | .label => { label := true }
  | .button => { interactive := true }
  | .progress => { progress := true }
  | .meter => { meter := true }
  | .noscript => { noscript := true }
  | .canvas => { interactive := true }
  | _ => {}

/-- A transparent element whose base in one context is not the context's. -/
def Base.override : Base → Tag → Option Base
  | .metadata, .noscript => some .only_link_style_meta_strict
  | _, _ => none

/-- The direct children a sentence admits first and outside any base
(`source` and `track` under `audio` and `video`, `area` under `map`). -/
def labelledChild : Tag → Tag → Bool
  | .audio, .source => true
  | .audio, .track => true
  | .video, .source => true
  | .video, .track => true
  | .map, .area => true
  | _, _ => false

/-- The labelled direct children of a parent, as a list. -/
def Tag.labelled : Tag → List Tag
  | .audio => [.source, .track]
  | .video => [.source, .track]
  | .map => [.area]
  | _ => []

end Whatwg.Html.Schema
